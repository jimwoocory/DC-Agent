{
  "feature": "feishu_god_mode_tool_server",
  "goal": "Wrap DC-Agent as a Feishu-native administrator approval tool mode while keeping Eve/OpenAPI/MCP as future optional outer clients.",
  "acceptance_criteria": [
    {
      "id": "feishu-god-mode-001",
      "description": "/god command parsing supports natural language plans, status lookup, and cancellation without changing the normal DC Router message path.",
      "verification": "uv run pytest tests/test_god_mode.py::test_parse_god_command_variants -q"
    },
    {
      "id": "feishu-god-mode-002",
      "description": "Only God Mode owners or admins can initiate /god, and side-effect capabilities are identified before any execution.",
      "verification": "uv run pytest tests/test_god_mode.py::test_non_owner_request_is_refused tests/test_god_mode.py::test_side_effect_action_requires_approval -q"
    },
    {
      "id": "feishu-god-mode-003",
      "description": "Read-only /god plans return directly while side-effect plans wait for approval.",
      "verification": "uv run pytest tests/test_god_mode.py::test_read_only_harness_status_completes_without_approval -q"
    },
    {
      "id": "feishu-god-mode-004",
      "description": "Approval card actions use source=god_mode_approval with run_id, action_id, and decision=approve|reject, and approved actions execute idempotently by run_id + action_id.",
      "verification": "uv run pytest tests/test_god_mode.py::test_approve_action_is_idempotent tests/test_god_mode_plugin.py::test_approval_card_contains_required_value_payload -q"
    },
    {
      "id": "feishu-god-mode-005",
      "description": "Every request, plan, approval, and execution writes append-only SQLite audit rows with Feishu correlation fields and redacted sensitive values.",
      "verification": "uv run pytest tests/test_god_mode.py::test_audit_redacts_sensitive_values -q"
    },
    {
      "id": "feishu-god-mode-006",
      "description": "The Feishu plugin remains a thin adapter over dc_engines.god_mode and handles admin command flow plus trusted card callbacks.",
      "verification": "uv run pytest tests/test_god_mode_plugin.py::test_admin_read_only_god_command_returns_result tests/test_god_mode_plugin.py::test_non_admin_god_command_is_refused tests/test_god_mode_plugin.py::test_admin_side_effect_request_sends_approval_card -q"
    },
    {
      "id": "feishu-god-mode-007",
      "description": "The contract itself names the future Eve/OpenAPI/MCP reusable tool fragments.",
      "verification": "uv run pytest tests/harness/test_feishu_god_mode_tool_server_contract.py -q"
    }
  ],
  "command_semantics": {
    "/god <task>": "Generate a plan. Read-only actions may complete immediately; side-effect actions wait for approval.",
    "/god status [run_id]": "Show the latest run or a specific run.",
    "/god cancel <run_id>": "Cancel a pending or unfinished run."
  },
  "tool_fragments": [
    "dc_agent_route_message",
    "dc_agent_query_memory",
    "dc_agent_start_workflow",
    "dc_agent_send_feishu_card",
    "dc_agent_check_task_status",
    "dc_agent_run_contract_check"
  ],
  "safety_model": {
    "default_permission": "owners_or_admins_can_initiate_side_effects_require_approval",
    "approval_card_source": "god_mode_approval",
    "approval_card_value_fields": ["source", "run_id", "action_id", "decision"],
    "idempotency_key": ["run_id", "action_id"],
    "trusted_card_action_only": true,
    "side_effect_capabilities": [
      "feishu_card",
      "harness",
      "hermes",
      "memory_write",
      "external_generation",
      "shell",
      "devops"
    ],
    "audit_storage": "append_only_sqlite_events",
    "redaction_required": [
      "token",
      "secret",
      "password",
      "api_key",
      "authorization",
      "data/config sensitive contents"
    ]
  },
  "run_model": {
    "run_id": "string",
    "status": ["planned", "waiting_approval", "running", "completed", "failed", "cancelled"],
    "summary": "string",
    "actions": "array",
    "approval_required": "boolean",
    "audit_id": "string"
  },
  "verification": {
    "unit": "uv run pytest tests/test_god_mode.py -q",
    "plugin": "uv run pytest tests/test_god_mode_plugin.py -q",
    "contract": "uv run pytest tests/harness/test_feishu_god_mode_tool_server_contract.py -q",
    "targeted": "scripts/agent-check.sh --profile targeted",
    "format": "ruff format .",
    "lint": "ruff check .",
    "hygiene": "make clean-pyc && make check-clean"
  }
}
