# knowledge_cycle 治理环路开关（声明式单一来源）
# 由 scripts-watchdog/knowledge_cycle.py 在 STEP_CONFIG 固化前加载；
# 真实环境变量优先于本文件（可临时用 env 压制）。
# 2026-06-13 P0 通电：export / import / promote 接入 dc-watchdog 每分钟 tick 调度。

# NAS 文档候选导出 → Obsidian Inbox（每小时，单次最多 50 条）
KNOWLEDGE_ENABLE_OBSIDIAN_GOVERNANCE_EXPORT=1
KNOWLEDGE_OBSIDIAN_GOVERNANCE_EXPORT_LIMIT=50

# harness task_outcome 任务记忆导出 → Obsidian Inbox（每小时，单次最多 20 条）
KNOWLEDGE_ENABLE_OBSIDIAN_GOVERNANCE_EXPORT_TASKS=1
KNOWLEDGE_OBSIDIAN_GOVERNANCE_EXPORT_TASKS_LIMIT=20

# Obsidian 人审结果回灌 governed_memory.db（每小时）
KNOWLEDGE_ENABLE_OBSIDIAN_GOVERNANCE_IMPORT=1

# approved 记忆晋升到运行时召回（每小时，关闭 dry_run 真实生效）
KNOWLEDGE_ENABLE_OBSIDIAN_GOVERNANCE_PROMOTE=1
KNOWLEDGE_OBSIDIAN_GOVERNANCE_PROMOTE_DRY_RUN=0

# NAS 源内容变更检测：approved 记忆 source_hash 漂移 → 标 stale 打回 Inbox（每 6 小时）
KNOWLEDGE_ENABLE_OBSIDIAN_GOVERNANCE_STALE_SCAN=1
