{
  "feature": "harness_lifecycle_state_machine",
  "goal": "Keep Harness task lifecycle transitions explicit so production plugins cannot reopen terminal tasks, bypass review-required approval, or directly complete blocked work without resuming execution.",
  "acceptance_criteria": [
    {
      "id": "harness-lifecycle-001",
      "description": "HarnessEngine rejects illegal lifecycle transitions, including terminal task mutation and blocked-to-completed shortcut completion.",
      "verification": "uv run pytest dc_engines/tests/test_harness_lifecycle.py::test_state_machine_rejects_terminal_task_reopen dc_engines/tests/test_harness_lifecycle.py::test_state_machine_rejects_blocked_direct_completion dc_engines/tests/test_harness_lifecycle.py::test_state_machine_store_rejects_stale_status_update -q"
    },
    {
      "id": "harness-lifecycle-002",
      "description": "review_required and review_required_by_default tasks cannot move to completed until they pass the review gate, and approvals can only be recorded while the task is in review_required.",
      "verification": "uv run pytest dc_engines/tests/test_harness_lifecycle.py::test_review_required_completion_requires_approved_review dc_engines/tests/test_harness_lifecycle.py::test_review_required_by_default_cannot_complete_before_review_gate dc_engines/tests/test_harness_lifecycle.py::test_approve_task_requires_review_required_status -q"
    },
    {
      "id": "harness-lifecycle-003",
      "description": "Harness sensor auto-completion excludes review_required tasks and treats missing, incomplete, or unverifiable responses as insufficient materials instead of successful completion.",
      "verification": "uv run pytest dc_engines/tests/test_harness_sensor_plugin.py::test_sensor_excludes_review_required_from_auto_complete dc_engines/tests/test_harness_sensor_plugin.py::test_sensor_settle_skips_review_required_success_response dc_engines/tests/test_harness_sensor_plugin.py::test_sensor_excludes_review_required_by_default_auto_complete dc_engines/tests/test_harness_sensor_plugin.py::test_sensor_keeps_success_text_with_negated_missing_terms_success dc_engines/tests/harness_sensor_plugin_truth_intake_test.py::test_sensor_classifies_missing_materials_as_insufficient dc_engines/tests/harness_sensor_plugin_truth_intake_test.py::test_sensor_classifies_no_hits_and_whitelist_missing_as_insufficient -q"
    },
    {
      "id": "harness-lifecycle-004",
      "description": "Workflow task producers only set auto_complete_on_response when the payload is not review-required, generation is allowed, and no required inputs are missing.",
      "verification": "uv run pytest dc_engines/tests/test_workflow_intent_plugin.py::test_workflow_intent_review_required_kind_disables_auto_complete dc_engines/tests/test_workflow_intent_plugin.py::test_workflow_intent_project_followup_auto_completes_when_allowed dc_engines/tests/test_department_workflows.py::test_build_request_payload_contains_harness_requirements dc_engines/tests/test_department_workflows.py::test_department_requester_meta_cannot_override_auto_complete_gate dc_engines/tests/test_department_workflows.py::test_client_followup_material_gap_blocks_generation dc_engines/tests/test_department_workflows.py::test_client_private_domain_ready_payload_has_review_outputs -q"
    },
    {
      "id": "harness-lifecycle-005",
      "description": "Department workflow plugin tests verify producer-side auto-complete gates without mixing top-level and dc_engines pytest conftests.",
      "verification": "uv run pytest tests/test_department_workflow_plugin_content_sop.py::test_department_workflow_plugin_does_not_override_auto_complete_gate -q"
    }
  ],
  "verification": {
    "targeted": "scripts/agent-check.sh --profile targeted",
    "full": "scripts/agent-check.sh --profile full"
  }
}
